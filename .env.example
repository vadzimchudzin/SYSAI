# Скопируйте в .env и заполните. Файл .env никогда не коммитится.
ADMIN_USERNAME=SYSAI
ADMIN_PASSWORD=SYSAI   # смените перед публикацией ссылки
SECRET_KEY=длинная-случайная-строка
OPENROUTER_API_KEY=sk-or-...
# Распознавание речи (ElevenLabs Scribe); ключ можно вставить и в Настройках
ELEVENLABS_API_KEY=
TELEGRAM_BOT_TOKEN=123456:ABC...
# webhook (сервер с публичным адресом) | polling (локально) | off
TELEGRAM_MODE=webhook
# Публичный адрес сервиса (на Render подставляется сам из RENDER_EXTERNAL_URL)
PUBLIC_URL=
# Пусто = SQLite в ./data. Для Postgres: postgresql+psycopg://user:pass@host/db
# Neon: скопируйте строку из Connect (с включённым Connection pooling), sslmode добавится сам.
DATABASE_URL=
# Docker Compose использует отдельный PostgreSQL. Задайте случайный пароль из букв и цифр.
POSTGRES_PASSWORD=
# Порт БД доступен только на localhost.
POSTGRES_PORT=5433
TIMEZONE=Europe/Minsk
# Позже: https://ваш-портал.bitrix24.by/rest/1/xxxxxxxx
BITRIX_WEBHOOK_URL=
