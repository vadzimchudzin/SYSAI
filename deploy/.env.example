# Скопируйте этот файл в .env и заполните. Файл .env никогда не коммитится.
# Комментарии только на отдельных строках, после значения их писать нельзя.

# Пароль базы: только буквы и цифры (он входит в адрес подключения).
# Получить: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# Вход в кабинет. Пока пароль SYSAI (или пустой) или SECRET_KEY по умолчанию, вход закрыт.
ADMIN_USERNAME=SYSAI
ADMIN_PASSWORD=

# Длинная случайная строка. При переезде с Render возьмите то же значение, что стоит там:
# от него зависит шифрование сессии Telegram в базе. Другое значение значит войти в аккаунт Telegram заново.
SECRET_KEY=

# Адрес, по которому открывают сайт, без https://: IP сервера, имя в локальной сети или домен.
SITE_ADDRESS=

# internal: Caddy сам делает сертификат для локальной сети (его нужно один раз установить на компьютерах, см. README).
# Домен, открытый из интернета: впишите свою почту, Caddy получит сертификат Let's Encrypt.
TLS_ARG=internal

TIMEZONE=Europe/Minsk

# polling: бот Telegram работает без публичного адреса. В режиме ИИ-сотрудника (аккаунт вместо бота) значение не используется.
TELEGRAM_MODE=polling

# Публичный адрес с https://. Нужен только для ссылок «Править в панели» в сообщениях бота.
PUBLIC_URL=

# Ключи можно не писать здесь, а вставить в Настройках кабинета.
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
# Optional Vercel API for consented local ECAPA voice identity.
SYSAI_VOICE_SERVICE_URL=https://sysai-speaker-id.vercel.app
SYSAI_VOICE_SERVICE_TOKEN=
SYSAI_VOICE_MATCH_THRESHOLD=0.55
SYSAI_VOICE_MATCH_MARGIN=0.08

BITRIX_WEBHOOK_URL=

# Сколько дней хранить ночные дампы базы.
BACKUP_KEEP_DAYS=14
